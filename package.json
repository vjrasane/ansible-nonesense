{
  "name": "@sensible-ts/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./builtin": {
      "types": "./dist/builtin/index.d.ts",
      "default": "./dist/builtin/index.js"
    },
    "./community-general": {
      "types": "./dist/community-general/index.d.ts",
      "default": "./dist/community-general/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "codegen": "tsx src/codegen/codegen-builtin.ts && tsx src/codegen/codegen-collection.ts community.general",
    "codegen:builtin": "tsx src/codegen/codegen-builtin.ts",
    "codegen:collection": "tsx src/codegen/codegen-collection.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "env-paths": "^4.0.0",
    "fflate": "^0.8.3",
    "tar": "^7.5.22",
    "ts-poet": "^6.12.0"
  }
}
